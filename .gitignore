# Quartus compilation databases
db/
incremental_db/
greybox_tmp/
.qsys_edit/

# Generated output files
output_files/

# Quartus cache and temporary files
*.qws
*.smsg
*.ddb
*.rpt
*.summary
*.jdi

# Programming files (optional)
*.sof
*.pof
*.jam
*.jbc
*.rbf

# Backup files
*.bak
*.vhd.bak
*.v.bak
*.sv.bak

# Autosave / editor files
*~
*.swp
*.swo

# Simulation outputs
transcript
work/
vsim.wlf
modelsim.ini

# Generated IP outputs
ip/**/*.cmp
ip/**/*.bsf
ip/**/*.sip
ip/**/*.spd

# OS files
.DS_Store
Thumbs.db
# --- project-specific additions ---

# Quartus synthesis report dumped to the repo root
/report.txt

# Floppy / disk images (large; contain third-party DOS & games)
*.img
*.IMA
*.ima

# Third-party tool executables (nasm/ndisasm etc. — not our source)
*.exe

# tools/ build outputs (regenerable from the .s / .asm sources)
tools/*.bin
tools/*.BIN
tools/*.64k
tools/*.com
tools/*.o
tools/*.mif
tools/*.crc
tools/*.EXE
# ...but keep the generated 8x8 font: it's a tiny build input for the BIOS
!tools/font8x8.bin
tools/philips.asm

# Philips ROM images -- dumps of commercial ROMs, not ours to redistribute.
# Same policy as tools/philips.asm. The derived font bitmaps in font.vhd and
# tools/font8x8.bin ARE committed; regenerate them with tools/mkfont_p2120.py
# after putting the character ROM back in place. See tools/p2120/README.md.
tools/[Pp]2120/*.bin

# Python bytecode
__pycache__/
*.pyc

# Configuration-flash images (regenerate with tools/mkjic.sh)
*.jic

# generated by mkbios.sh: the build stamp
tools/gitver.inc

# Commercial game data used for testing -- not ours to publish
tools/keen4c/
