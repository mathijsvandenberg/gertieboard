# The bus clock is a fabric counter output now, not a PLL output, and it feeds
# most of the design plus the CPU_CLK pin. Quartus normally promotes a net like
# that on its own; saying so makes it a build-time error rather than a silent
# fallback to routing fabric, which would show up as skew nobody constrained.
set_instance_assignment -name GLOBAL_SIGNAL "GLOBAL CLOCK" -to cpuclk1|clk_q

set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
